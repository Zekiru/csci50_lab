.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"


*******************************************************************************
* Full-Adder & 32-Bit Ripple-Carry Adder
*******************************************************************************
.subckt fa a b carry_in sum carry_out
    Xsum1 a b i xor2
    Xsum2 i carry_in sum xor2
    Xc_out1 a b j nand2
    Xc_out2 i carry_in k nand2
    Xc_out3 j k carry_out nand2
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
    Xadd a[31:0] b[31:0] cout[30:0] cin0 sum[31:0] cout[31:0] fa
.ends


*******************************************************************************
* 32-bit NOR
*******************************************************************************
.subckt nor32 i[31:0] z
    Xnor0 i[31:28] x0 nor4
    Xnor1 i[27:24] x1 nor4
    Xnor2 i[23:20] x2 nor4
    Xnor3 i[19:16] x3 nor4
    Xnor4 i[15:12] x4 nor4
    Xnor5 i[11:8] x5 nor4
    Xnor6 i[7:4] x6 nor4
    Xnor7 i[3:0] x7 nor4
    Xnand0 x[7:4] y0 nand4
    Xnand1 x[3:0] y1 nand4
    Xnor8 y[1:0] z nor2
.ends


*******************************************************************************
* Adder-Subtractor
*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
    Xop op0#32 b[31:0] bnew[31:0] xor2
    Xadd32 a[31:0] bnew[31:0] op0 fas[31:0] c[31:30] add32
    .connect n fas31
    Xover c[31:30] v xor2
    Xzero fas[31:0] z nor32
.ends


*******************************************************************************
* Comparator
*******************************************************************************
.subckt cmp32 n v z op[2:1] fcmp[31:0]
    Xequal op1 z equal nand2
    Xxor n v l xor2
    Xless op2 l less nand2
    Xcmp equal less fcmp0 nand2
    .connect 0 fcmp[31:1]
.ends


*******************************************************************************
* Bitwise Boolean
*******************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
    Xbool32 a[31:0] b[31:0] op0#32 op1#32 op2#32 op3#32 fbool[31:0] mux4
.ends 


*******************************************************************************
* Bit Shifter A: Bi-Directional Shifter
* total circuit size = 881 gates (18637.0 microns^2)
* propagation delay = 2.55ns
*******************************************************************************
.subckt shift32a a[31:0] b[4:0] op[1:0] fshift[31:0]
    Xashift op1 a31 s and2
    Xshift16 op0#32 b4#32 a[31:0]#2 a[15:0] 0#16 s#16 a[31:16] i[31:0] mux4
    Xshift8 op0#32 b3#32 i[31:0]#2 i[23:0] 0#8 s#8 i[31:8] j[31:0] mux4
    Xshift4 op0#32 b2#32 j[31:0]#2 j[27:0] 0#4 s#4 j[31:4] k[31:0] mux4
    Xshift2 op0#32 b1#32 k[31:0]#2 k[29:0] 0#2 s#2 k[31:2] l[31:0] mux4
    Xshift1 op0#32 b0#32 l[31:0]#2 l[30:0] 0 s l[31:1] fshift[31:0] mux4
.ends


*******************************************************************************
* Bit Shifter B: One-Direction Shifter with Bit-Reversers
* total circuit size = 625 gates (14125.0 microns^2)
* propagation delay = 1.98 ns
*******************************************************************************
.subckt shift32b a[31:0] b[4:0] op[1:0] fshift[31:0]
    Xashift op1 a31 s and2
    Xrevin op0#32 a[0:31] a[31:0] i[31:0] mux2
    Xshift16 b4#32 i[31:0] s#16 i[31:16] j[31:0] mux2
    Xshift8 b3#32 j[31:0] s#8 j[31:8] k[31:0] mux2
    Xshift4 b2#32 k[31:0] s#4 k[31:4] l[31:0] mux2
    Xshift2 b1#32 l[31:0] s#2 l[31:2] m[31:0] mux2
    Xshift1 b0#32 m[31:0] s m[31:1] n[31:0] mux2
    Xrevout op0#32 n[0:31] n[31:0] fshift[31:0] mux2
.ends


*******************************************************************************
* ALU
*******************************************************************************
.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0]
    Xas a[31:0] b[31:0] alufn0 fas[31:0] n v z as32
    Xbool a[31:0] b[31:0] alufn[3:0] fbool[31:0] bool32
    Xshift a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32b
    Xcmp n v z alufn[2:1] fcmp[31:0] cmp32
    Xalum alufn4#32 alufn5#32
    + fas[31:0] fbool[31:0] fshift[31:0] fcmp[31:0]
    + f[31:0] mux4
.ends

Xalu32 a[31:0] b[31:0] alufn[5:0] f[31:0] alu32


*******************************************************************************
* Test Cases
*******************************************************************************
Wa a[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ -1 0x55555555 0xAAAAAAAA 1 -2 -1 -1 0x55555555 0 -1 0x55555555 0
+ -1 0x55555555 0 -1 0x55555555 0 -1 0x55555555 0 1 -1 -1 0x55555555 0xAAAAAAAA -1
+ 0x55555555 0xAAAAAAAA -1 -1 15 0 -1 15 0 -1 15 0

Wb b[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ 1 0x55555555 0xAAAAAAAA 1 0 -1 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0
+ -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 31 15 0 24 24 31
+ 24 24 31 1 15 -256 1 15 -256 1 15 -256

Wf alufn[5:0] nrz(0v,5.0v,60ns,0ns,.1ns,.1ns)
+ 0 1 24 30 22 26 21 32 33 35 51 53 55


*******************************************************************************
* Transient and Plot Commands
* Note: sd() displays a range of nodes as a signed decimal (instead of hex)
*******************************************************************************
.tran 800ns
.plot sd(a[31:0])
.plot b(a[31:0])
.plot sd(b[31:0])
.plot b(b[31:0])
.plot b(alufn[5:0])
.plot sd(f[31:0])
.plot b(f[31:0])


