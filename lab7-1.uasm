|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm

        LD(INPUT, r0)

LOOP:   CMPLE(r0, r31, r6)
        BNE(r6, DONE)
        SUBC(r0, 1, r0)         | decrement the array counter
        ADDC(r1, 4, r1)         | byte-displacement counter
        LD(r1, INPUT, r2)       |
        ANDC(r2, 1, r3)         | Check if least-significant bit is 1
        BEQ(r3, ELSE)           | Branch to ELSE if even
        ADD(r4, r2, r4)         | r4 = sum of odd numbers
        BR(NEXT)                | Skip next instruction
ELSE:   ADD(r5, r2, r5)         | r5 = sum of even numbers
NEXT:   BEQ(r31, LOOP)          | (B)ranch back to LOOP
DONE:
        ST(r4, ODDSUM)
        ST(r5, EVENSUM)

        HALT()                  | then, finish execution

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

. = 0x19C

INPUT:
        LONG(7)             | <-- length of the array
        LONG(4)             | <-- first element of the array
        LONG(-1)
        LONG(1)
        LONG(0)
        LONG(-1)
        LONG(5)
        LONG(-2)            | <-- last element of the array

ODDSUM: LONG(0)
EVENSUM:
