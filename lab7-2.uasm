.include beta.uasm

        LD(INPUT, r0)       | r0 = array counter (size)
        CMOVE(1, r2)        | Set r2 to 1 to allow the sequence to go
                            |  from 0 to 1 

LOOP:   CMPLE(r0, r31, r6)  | Break while-loop if:
        BNE(r6, DONE)       |  array counter <= 0
        SUBC(r0, 1, r0)     | Decrement the array counter
        ADDC(r1, 4, r1)     | Byte-displacement counter (+4)
        ST(r4, FIBO, r1)    | Store current fibonacci number
        ADD(r2, r3, r4)     | r2 + r3 = next fibonacci number
        MOVE(r3, r2)        | Shift addends forward in the sequence
        MOVE(r4, r3)        | 
        BEQ(r31, LOOP)      | (B)ranch back to LOOP
DONE:   
        HALT()              | then, finish execution

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

. = 0x19C

INPUT:  LONG(7)             | <-- length of fibonacci sequence
